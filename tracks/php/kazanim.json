     {"kod": "6.3", "baslik": "Oturum güvenliği ve CSRF"},
     {"kod": "6.4", "baslik": "Parola özetleme"},
     {"kod": "6.5", "baslik": "Girdi doğrulama ve dosya yükleme", "not": "ctype ile doğrulama var; filter_var ve dosya yükleme işlenmedi."}
    ]},
    {"kod": "7", "baslik": "Girdi/çıktı", "maddeler": [
     {"kod": "7.1", "baslik": "Dosya okumak ve yazmak; include ve require"},
