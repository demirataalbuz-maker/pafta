     {"kod": "5.4", "baslik": "Sihirli metotlar, trait'ler ve otomatik yükleme"},
     {"kod": "5.5", "baslik": "Yansıma (Reflection)", "not": "Henüz bir paftada işlenmedi."}
    ]},
    {"kod": "6", "baslik": "Güvenlik", "maddeler": [
